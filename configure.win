#!/bin/sh
set -e

export PATH="$PATH:$HOME/.cargo/bin"
if command -v cargo >/dev/null 2>&1; then
  cargo --version
  rustc --version || true
else
  echo "ERROR: cargo was not found on PATH. Install Rust with rustup." >&2
  exit 1
fi

cp src/Makevars.win.in src/Makevars.win
cat <<EOF
SIMD demo: Rust target_feature kernels are linked into one R shared library.
SIMD demo: C dispatch uses Rust-reported compiled and runtime CPU features.
EOF
exit 0
